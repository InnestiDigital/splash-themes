{
  "type": "gallery",
  "label": "Gallery",
  "description": "Image gallery section with grid, masonry, or strip layouts.",
  "usesContainer": true,
  "layoutSlots": [
    { "role": "section-heading", "required": false, "multiple": false, "description": "Gallery title and intro (renders at top)" },
    { "role": "editorial-body", "required": false, "multiple": true, "description": "Optional intro blocks (render between heading and gallery)" },
    { "role": "media-gallery", "required": true, "multiple": true, "description": "Gallery items (render in grid/masonry/strip layout)" },
    { "role": "section-cta", "required": false, "multiple": true, "description": "Call-to-action blocks (render at bottom of gallery)" }
  ],
  "layout": {
    "engine": "grid",
    "tiers": [
      { "id": "full", "minWidth": "md" },
      { "id": "stack", "minWidth": null }
    ],
    "areas": {
      "full": ["heading", "intro", "gallery", "cta"],
      "stack": ["heading", "intro", "gallery", "cta"]
    },
    "columns": {
      "full": "minmax(0, 1fr)",
      "stack": "minmax(0, 1fr)"
    },
    "rows": {
      "full": "auto auto auto auto",
      "stack": "auto auto auto auto"
    },
    "gap": { "row": "lg", "column": "none" },
    "placeItems": "start stretch",
    "zones": {
      "heading": { "flow": "stack", "gap": "md", "placeSelf": "start stretch" },
      "intro": { "flow": "stack", "gap": "md", "placeSelf": "start stretch" },
      "gallery": { "flow": "stack", "gap": "md", "placeSelf": "start stretch" },
      "cta": { "flow": "stack", "gap": "md", "placeSelf": "start stretch" }
    },
    "slots": [
      { "role": "section-heading", "zone": "heading", "flow": "stack", "flowOptions": { "gap": "md" } },
      { "role": "editorial-body", "zone": "intro", "flow": "stack", "flowOptions": { "gap": "md" } },
      {
        "role": "media-gallery",
        "zone": "gallery",
        "flow": "grid",
        "flowOptions": {
          "gap": "md",
          "columns": 3,
          "pattern": "every-third",
          "autoplay": false,
          "interval": 5,
          "showDots": true,
          "showArrows": true
        }
      },
      { "role": "section-cta", "zone": "cta", "flow": "stack", "flowOptions": { "gap": "md" } }
    ]
  },
  "settings": [
    {
      "id": "layout",
      "type": "select",
      "label": "Layout",
      "default": "grid",
      "group": "layout",
      "layoutBind": [{ "target": "slot.media-gallery.flow" }],
      "options": [
        { "value": "grid", "label": "Grid", "layoutValues": { "slot.media-gallery.flow": "grid" } },
        { "value": "masonry", "label": "Masonry", "layoutValues": { "slot.media-gallery.flow": "masonry" } },
        { "value": "strip", "label": "Strip", "layoutValues": { "slot.media-gallery.flow": "strip" } },
        { "value": "carousel", "label": "Carousel", "layoutValues": { "slot.media-gallery.flow": "carousel" } }
      ],
      "note": "The four gallery layouts are the four reusable slot-flow modes. Any slot on any section type can now use them."
    },
    {
      "id": "columns",
      "type": "select",
      "label": "Columns",
      "default": "3",
      "group": "layout",
      "layoutBind": [{ "target": "slot.media-gallery.flowOptions.columns" }],
      "options": [
        { "value": "2", "label": "2 Columns", "layoutValues": { "slot.media-gallery.flowOptions.columns": 2 } },
        { "value": "3", "label": "3 Columns", "layoutValues": { "slot.media-gallery.flowOptions.columns": 3 } },
        { "value": "4", "label": "4 Columns", "layoutValues": { "slot.media-gallery.flowOptions.columns": 4 } }
      ],
      "showIf": { "layout": ["grid", "masonry", "strip"] },
      "note": "Tier-unscoped: the floor-tier column cap is effectiveColumns() in the flow renderer, mirroring the legacy repeat(min(var(--gallery-columns), 2), 1fr) rule. Binding the `full` tier instead would make the stack tier fall back to the schema's own count rather than capping the authored one."
    },
    {
      "id": "gap",
      "type": "select",
      "label": "Block Spacing",
      "description": "Space between blocks within this section",
      "default": "md",
      "group": "layout",
      "migratedFrom": "gap",
      "layoutBind": [{ "target": "slot.media-gallery.flowOptions.gap" }],
      "options": [
        { "value": "none", "label": "None", "layoutValues": { "slot.media-gallery.flowOptions.gap": "none" } },
        { "value": "sm", "label": "Tight", "layoutValues": { "slot.media-gallery.flowOptions.gap": "sm" } },
        { "value": "md", "label": "Normal", "layoutValues": { "slot.media-gallery.flowOptions.gap": "md" } },
        { "value": "lg", "label": "Loose", "layoutValues": { "slot.media-gallery.flowOptions.gap": "lg" } }
      ]
    },
    {
      "id": "stripPattern",
      "type": "select",
      "label": "Featured Pattern",
      "default": "every-third",
      "description": "Controls which items are displayed larger in the strip layout",
      "group": "layout",
      "layoutBind": [{ "target": "slot.media-gallery.flowOptions.pattern" }],
      "options": [
        { "value": "first", "label": "First Item Large", "layoutValues": { "slot.media-gallery.flowOptions.pattern": "first" } },
        { "value": "every-third", "label": "Every Third Large", "layoutValues": { "slot.media-gallery.flowOptions.pattern": "every-third" } },
        { "value": "alternating", "label": "Alternating Large/Small", "layoutValues": { "slot.media-gallery.flowOptions.pattern": "alternating" } }
      ],
      "showIf": { "layout": "strip" }
    },
    {
      "id": "autoplay",
      "type": "toggle",
      "label": "Auto Play",
      "default": false,
      "group": "carousel",
      "layoutBind": [{ "target": "slot.media-gallery.flowOptions.autoplay" }],
      "layoutValue": { "slot.media-gallery.flowOptions.autoplay": true },
      "layoutValueOff": { "slot.media-gallery.flowOptions.autoplay": false },
      "showIf": { "layout": "carousel" }
    },
    {
      "id": "interval",
      "type": "number",
      "label": "Interval (seconds)",
      "default": 5,
      "min": 3,
      "max": 10,
      "group": "carousel",
      "showIf": { "layout": "carousel", "autoplay": true },
      "note": "Unbound: `number` cannot carry layoutBind (no enumerated option list to validate against). Timing is behaviour, not geometry — the carousel flow reads it from layoutConfig directly."
    },
    {
      "id": "showDots",
      "type": "toggle",
      "label": "Show Dots",
      "default": true,
      "group": "carousel",
      "layoutBind": [{ "target": "slot.media-gallery.flowOptions.showDots" }],
      "layoutValue": { "slot.media-gallery.flowOptions.showDots": true },
      "layoutValueOff": { "slot.media-gallery.flowOptions.showDots": false },
      "showIf": { "layout": "carousel" }
    },
    {
      "id": "showArrows",
      "type": "toggle",
      "label": "Show Arrows",
      "default": true,
      "group": "carousel",
      "layoutBind": [{ "target": "slot.media-gallery.flowOptions.showArrows" }],
      "layoutValue": { "slot.media-gallery.flowOptions.showArrows": true },
      "layoutValueOff": { "slot.media-gallery.flowOptions.showArrows": false },
      "showIf": { "layout": "carousel" }
    },
    {
      "id": "carouselColumns",
      "type": "select",
      "label": "Slides per Page",
      "description": "Desktop slide count. Tablet caps at 2; mobile always shows 1.",
      "default": "3",
      "group": "carousel",
      "layoutBind": [{ "target": "slot.media-gallery.flowOptions.columns" }],
      "options": [
        { "value": "1", "label": "1 — Full bleed", "layoutValues": { "slot.media-gallery.flowOptions.columns": 1 } },
        { "value": "2", "label": "2", "layoutValues": { "slot.media-gallery.flowOptions.columns": 2 } },
        { "value": "3", "label": "3", "layoutValues": { "slot.media-gallery.flowOptions.columns": 3 } },
        { "value": "4", "label": "4 — Compact", "layoutValues": { "slot.media-gallery.flowOptions.columns": 4 } }
      ],
      "showIf": { "layout": "carousel" },
      "note": "Shares the `columns` flow option with the grid/masonry/strip `columns` setting. The two are mutually exclusive by showIf, but the validator's uniqueness rule must be scoped per visible branch — see contract §8 rule 8."
    },
    {
      "id": "typographyScale",
      "type": "select",
      "label": "Typography Scale",
      "description": "Scales all headings within this section",
      "default": "default",
      "group": "layout",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "display", "label": "Display (larger headings)" },
        { "value": "compact", "label": "Compact (smaller headings)" }
      ]
    },
    {
      "id": "dividerTop",
      "type": "select",
      "label": "Top Edge Shape",
      "description": "Decorative SVG separator at the top of this section, filled with the section background so the colour flows into the section above.",
      "default": "none",
      "group": "divider",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "wave", "label": "Wave" },
        { "value": "curve", "label": "Curve" },
        { "value": "tilt", "label": "Tilt" },
        { "value": "triangle", "label": "Triangle" },
        { "value": "zigzag", "label": "Zigzag" },
        { "value": "arrow", "label": "Arrow" }
      ]
    },
    {
      "id": "dividerBottom",
      "type": "select",
      "label": "Bottom Edge Shape",
      "description": "Decorative SVG separator at the bottom of this section, filled with the section background so the colour flows into the section below.",
      "default": "none",
      "group": "divider",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "wave", "label": "Wave" },
        { "value": "curve", "label": "Curve" },
        { "value": "tilt", "label": "Tilt" },
        { "value": "triangle", "label": "Triangle" },
        { "value": "zigzag", "label": "Zigzag" },
        { "value": "arrow", "label": "Arrow" }
      ]
    },
    {
      "id": "dividerHeight",
      "type": "select",
      "label": "Divider Height",
      "description": "Height of the shape dividers on this section.",
      "default": "md",
      "group": "divider",
      "options": [
        { "value": "sm", "label": "Small" },
        { "value": "md", "label": "Medium" },
        { "value": "lg", "label": "Large" }
      ]
    },
    {
      "id": "dividerFlip",
      "type": "toggle",
      "label": "Flip Direction",
      "description": "Mirror the divider shapes horizontally.",
      "default": false,
      "group": "divider"
    }
  ],
  "groups": [
    { "id": "layout", "label": "Layout" },
    { "id": "carousel", "label": "Carousel Settings" },
    { "id": "divider", "label": "Shape Dividers" }
  ]
}
