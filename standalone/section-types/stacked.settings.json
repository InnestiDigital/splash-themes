{
  "type": "stacked",
  "label": "Stacked",
  "description": "Blocks stacked vertically in position order. Default section type.",
  "usesContainer": true,
  "layoutSlots": [],
  "settings": [
    {
      "id": "shellLayout",
      "type": "select",
      "display": "visual-picker",
      "label": "Block Alignment",
      "default": "stacked",
      "group": "layout",
      "options": [
        { "value": "stacked", "label": "Default" },
        { "value": "centered", "label": "Centered" },
        { "value": "none", "label": "Raw" }
      ]
    },
    {
      "id": "contentAlignment",
      "type": "select",
      "label": "Content Alignment",
      "description": "Controls how blocks align within the section container",
      "default": "left",
      "group": "layout",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "full", "label": "Full Width" }
      ],
      "note": "Center mode is useful for editorial layouts. Use block-level width settings (e.g. maxWidth) to fine-tune individual block widths."
    },
    {
      "id": "stackGap",
      "type": "select",
      "label": "Block Spacing",
      "description": "Space between blocks within this section",
      "default": "md",
      "group": "layout",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "sm", "label": "Tight" },
        { "value": "md", "label": "Normal" },
        { "value": "lg", "label": "Spacious" }
      ]
    },
    {
      "id": "typographyScale",
      "type": "select",
      "label": "Typography Scale",
      "description": "Scales all headings within this section",
      "default": "default",
      "group": "layout",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "display", "label": "Display (larger headings)" },
        { "value": "compact", "label": "Compact (smaller headings)" }
      ]
    },
    {
      "id": "dividerTop",
      "type": "select",
      "label": "Top Edge Shape",
      "description": "Decorative SVG separator at the top of this section, filled with the section background so the colour flows into the section above.",
      "default": "none",
      "group": "divider",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "wave", "label": "Wave" },
        { "value": "curve", "label": "Curve" },
        { "value": "tilt", "label": "Tilt" },
        { "value": "triangle", "label": "Triangle" },
        { "value": "zigzag", "label": "Zigzag" },
        { "value": "arrow", "label": "Arrow" }
      ]
    },
    {
      "id": "dividerBottom",
      "type": "select",
      "label": "Bottom Edge Shape",
      "description": "Decorative SVG separator at the bottom of this section, filled with the section background so the colour flows into the section below.",
      "default": "none",
      "group": "divider",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "wave", "label": "Wave" },
        { "value": "curve", "label": "Curve" },
        { "value": "tilt", "label": "Tilt" },
        { "value": "triangle", "label": "Triangle" },
        { "value": "zigzag", "label": "Zigzag" },
        { "value": "arrow", "label": "Arrow" }
      ]
    },
    {
      "id": "dividerHeight",
      "type": "select",
      "label": "Divider Height",
      "description": "Height of the shape dividers on this section.",
      "default": "md",
      "group": "divider",
      "options": [
        { "value": "sm", "label": "Small" },
        { "value": "md", "label": "Medium" },
        { "value": "lg", "label": "Large" }
      ]
    },
    {
      "id": "dividerFlip",
      "type": "toggle",
      "label": "Flip Direction",
      "description": "Mirror the divider shapes horizontally.",
      "default": false,
      "group": "divider"
    }
  ],
  "groups": [
    { "id": "layout", "label": "Layout" },
    { "id": "divider", "label": "Shape Dividers" }
  ]
}
