{
  "type": "hero",
  "label": "Hero",
  "description": "Full-bleed hero section. Blocks fill the entire viewport area.",
  "usesContainer": false,
  "layoutSlots": [
    { "role": "section-heading", "required": false, "multiple": false, "description": "Section title and intro (centered overlay, only first block renders)" },
    { "role": "media-gallery", "required": false, "multiple": false, "description": "Background media (only first block renders, fills viewport)", "_comment": "Reuses global role vocabulary as pragmatic compromise. Semantically 'hero-media' would be more precise but fragmenting role names adds complexity. Layout enforces single-slot rendering." },
    { "role": "section-cta", "required": false, "multiple": true, "description": "Call-to-action blocks (render at bottom of hero)" }
  ],
  "settings": [
    {
      "id": "mediaPosition",
      "type": "select",
      "display": "visual-picker",
      "label": "Media Position",
      "default": "center",
      "group": "layout",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "top", "label": "Top" },
        { "value": "bottom", "label": "Bottom" },
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" },
        { "value": "top-left", "label": "Top Left" },
        { "value": "top-right", "label": "Top Right" },
        { "value": "bottom-left", "label": "Bottom Left" },
        { "value": "bottom-right", "label": "Bottom Right" }
      ],
      "note": "Focal point of the background/hero image (object/background position). Override per breakpoint below for art-directed mobile crops."
    },
    {
      "id": "mediaPositionTablet",
      "type": "select",
      "display": "visual-picker",
      "label": "Media Position (Tablet)",
      "default": "inherit",
      "group": "layout",
      "options": [
        { "value": "inherit", "label": "Inherit (Desktop)" },
        { "value": "center", "label": "Center" },
        { "value": "top", "label": "Top" },
        { "value": "bottom", "label": "Bottom" },
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" },
        { "value": "top-left", "label": "Top Left" },
        { "value": "top-right", "label": "Top Right" },
        { "value": "bottom-left", "label": "Bottom Left" },
        { "value": "bottom-right", "label": "Bottom Right" }
      ],
      "note": "Focal point on tablet. Inherit uses the desktop value."
    },
    {
      "id": "mediaPositionMobile",
      "type": "select",
      "display": "visual-picker",
      "label": "Media Position (Mobile)",
      "default": "inherit",
      "group": "layout",
      "options": [
        { "value": "inherit", "label": "Inherit (Tablet)" },
        { "value": "center", "label": "Center" },
        { "value": "top", "label": "Top" },
        { "value": "bottom", "label": "Bottom" },
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" },
        { "value": "top-left", "label": "Top Left" },
        { "value": "top-right", "label": "Top Right" },
        { "value": "bottom-left", "label": "Bottom Left" },
        { "value": "bottom-right", "label": "Bottom Right" }
      ],
      "note": "Focal point on mobile. Inherit falls back to tablet, then desktop. Focus the subject differently where a wide image is cropped narrow."
    },
    {
      "id": "contentAlign",
      "type": "select",
      "label": "Content Alignment",
      "default": "center",
      "group": "layout",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "bottom-left", "label": "Bottom Left" },
        { "value": "bottom-center", "label": "Bottom Center" },
        { "value": "bottom-right", "label": "Bottom Right" },
        { "value": "top-left", "label": "Top Left" },
        { "value": "top-center", "label": "Top Center" },
        { "value": "top-right", "label": "Top Right" }
      ],
      "note": "Position heading content within the hero section. Bottom-left common for editorial text over images."
    },
    {
      "id": "height",
      "type": "select",
      "label": "Height",
      "default": "viewport",
      "group": "layout",
      "options": [
        { "value": "viewport", "label": "Full Viewport (100vh)" },
        { "value": "large", "label": "Large (80vh)" },
        { "value": "medium", "label": "Medium (60vh)" },
        { "value": "auto", "label": "Auto (content height)" }
      ],
      "note": "Controls minimum height of hero section. Auto allows section to shrink to content size."
    },
    {
      "id": "typographyScale",
      "type": "select",
      "label": "Typography Scale",
      "description": "Scales all headings within this section",
      "default": "default",
      "group": "layout",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "display", "label": "Display (larger headings)" },
        { "value": "compact", "label": "Compact (smaller headings)" }
      ]
    },
    {
      "id": "dividerTop",
      "type": "select",
      "label": "Top Edge Shape",
      "description": "Decorative SVG separator at the top of this section, filled with the section background so the colour flows into the section above.",
      "default": "none",
      "group": "divider",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "wave", "label": "Wave" },
        { "value": "curve", "label": "Curve" },
        { "value": "tilt", "label": "Tilt" },
        { "value": "triangle", "label": "Triangle" },
        { "value": "zigzag", "label": "Zigzag" },
        { "value": "arrow", "label": "Arrow" }
      ]
    },
    {
      "id": "dividerBottom",
      "type": "select",
      "label": "Bottom Edge Shape",
      "description": "Decorative SVG separator at the bottom of this section, filled with the section background so the colour flows into the section below.",
      "default": "none",
      "group": "divider",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "wave", "label": "Wave" },
        { "value": "curve", "label": "Curve" },
        { "value": "tilt", "label": "Tilt" },
        { "value": "triangle", "label": "Triangle" },
        { "value": "zigzag", "label": "Zigzag" },
        { "value": "arrow", "label": "Arrow" }
      ]
    },
    {
      "id": "dividerHeight",
      "type": "select",
      "label": "Divider Height",
      "description": "Height of the shape dividers on this section.",
      "default": "md",
      "group": "divider",
      "options": [
        { "value": "sm", "label": "Small" },
        { "value": "md", "label": "Medium" },
        { "value": "lg", "label": "Large" }
      ]
    },
    {
      "id": "dividerFlip",
      "type": "toggle",
      "label": "Flip Direction",
      "description": "Mirror the divider shapes horizontally.",
      "default": false,
      "group": "divider"
    }
  ],
  "groups": [
    { "id": "layout", "label": "Layout" },
    { "id": "divider", "label": "Shape Dividers" }
  ]
}
