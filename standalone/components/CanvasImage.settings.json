{
  "component": "CanvasImage",
  "type": "canvas-image",
  "label": {
    "en-US": "Image"
  },
  "category": "media",
  "description": {
    "en-US": "Place one image with simple crop, framing, caption, and alignment controls."
  },
  "surfaces": [
    "canvas"
  ],
  "$fragments": ["media-art-direction"],
  "$fragmentOverrides": {
    "focalPoint": {
      "note": "Choose which part stays visible when the image is cropped.",
      "showIf": {
        "objectFit": "cover"
      }
    }
  },
  "tier": "basic",
  "keywords": [
    "photo",
    "picture",
    "media",
    "visual",
    "caption"
  ],
  "compatibleSectionRoles": [
    "media-gallery",
    "media-chrome",
    "editorial-body"
  ],
  "typographySlots": [],
  "settings": [
    {
      "type": "image",
      "id": "image",
      "label": {
        "en-US": "Image"
      },
      "group": "content"
    },
    {
      "type": "richtext-single",
      "id": "caption",
      "label": {
        "en-US": "Caption"
      },
      "group": "content",
      "translatable": true,
      "note": "Optional caption or credit shown beneath the image.",
      "validation": {
        "maxLength": 240
      }
    },
    {
      "type": "text",
      "id": "altText",
      "label": {
        "en-US": "Alternative text"
      },
      "group": "accessibility",
      "translatable": true,
      "note": "Describe the image for people using assistive technology.",
      "validation": {
        "maxLength": 240
      }
    },
