      "group": "content",
      "translatable": true,
      "typographyRole": "heading3",
      "defaultPresetKey": "section-title"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": {
        "en-US": "Body"
      },
      "group": "content",
      "translatable": true
    },
    {
      "type": "image",
      "id": "media",
      "label": {
        "en-US": "Media"
      },
      "group": "media"
    },
    {
      "type": "text",
      "id": "mediaAlt",
      "label": {
        "en-US": "Media Alt Text"
      },
      "group": "media",
      "translatable": true
    },
    {
      "type": "repeater",
      "id": "tags",
      "label": {
        "en-US": "Tags"
      },
      "group": "content",
      "fields": [
        {
          "type": "text",
          "id": "label",
          "label": {
            "en-US": "Label"
          },
          "translatable": true
        }
      ]
    },
    {
      "type": "url",
      "id": "link",
      "label": {
        "en-US": "Link URL"
      },
      "group": "cta"
    },
    {
      "type": "text",
      "id": "linkText",
      "label": {
        "en-US": "Link Text"
      },
      "group": "cta",
      "translatable": true
    },
    {
      "type": "select",
      "id": "hoverEffect",
      "label": {
        "en-US": "Hover Effect"
      },
      "default": "lift",
      "group": "style",
      "options": [
        {
          "value": "none",
          "label": {
            "en-US": "None"
          }
        },
        {
          "value": "lift",
          "label": {
            "en-US": "Lift"
          }
        },
        {
          "value": "depth",
          "label": {
            "en-US": "Depth"
          }
        }
      ]
