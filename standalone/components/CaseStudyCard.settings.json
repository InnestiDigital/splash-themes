  "groups": [
    {
      "id": "content",
      "label": {
        "en-US": "Content"
      }
    },
    {
      "id": "appearance",
      "label": {
        "en-US": "Appearance"
      }
    },
    {
      "id": "media",
      "label": {
        "en-US": "Media"
      }
    },
    {
      "id": "cta",
      "label": {
        "en-US": "Call to Action"
      }
    },
    {
      "id": "layout",
      "label": {
        "en-US": "Layout"
      }
    },
    {
      "id": "style",
      "label": {
        "en-US": "Style"
      }
    }
  ],
  "targets": {
    "root": {
      "description": "Card container",
      "kind": "root"
    },
    "media": {
      "selector": "[data-target='media']",
      "description": "Media element (parallax-ready)",
      "multiple": false,
      "animatable": [
        "opacity",
        "transform"
      ],
      "canTrigger": false,
      "kind": "media"
    },
    "heading": {
      "selector": "[data-target='heading']",
      "description": "Card heading",
      "multiple": false,
      "animatable": [
        "opacity",
        "transform",
        "blur",
        "clip-path"
      ],
      "canTrigger": true,
      "kind": "text"
    },
    "tags": {
      "selector": "[data-target='tags']",
      "description": "Tag items",
      "multiple": true,
      "animatable": [
        "opacity",
        "transform"
      ],
      "canTrigger": false,
      "kind": "text"
    },
    "body": {
      "selector": "[data-target='body']",
      "description": "Card body text",
      "multiple": false,
      "animatable": [
        "opacity",
        "transform",
        "blur"
      ],
      "canTrigger": true,
      "kind": "text"
    }
  },
  "motionSupport": {
    "levels": [
      "local",
      "group"
    ],
    "excluded": [],
    "nestedConstraints": {
      "waapiTransformConflict": true,
      "affectedTargets": [
        "root"
      ],
      "note": "CSS hover lift (transform: translateY) is suppressed by WAAPI fill:forwards on root. Do not assign transform animations to root when this block is inside a horizontal-scroll container."
    }
  }
