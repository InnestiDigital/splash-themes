      "options": [
        {
          "value": "none",
          "label": {
            "en-US": "None"
          }
        },
        {
          "value": "sm",
          "label": {
            "en-US": "Small"
          }
        },
        {
          "value": "md",
          "label": {
            "en-US": "Medium"
          }
        },
        {
          "value": "lg",
          "label": {
            "en-US": "Large"
          }
        },
        {
          "value": "pill",
          "label": {
            "en-US": "Pill"
          }
        }
      ],
      "default": "none",
      "group": "appearance"
    }
