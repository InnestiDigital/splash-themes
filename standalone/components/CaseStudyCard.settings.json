{
  "component": "CaseStudyCard",
  "type": "case-study-card",
  "label": {
    "en-US": "Case Study Card"
  },
  "category": "content",
  "compatibleSectionRoles": [
    "editorial-body"
  ],
  "typographySlots": [
    {
      "slot": "body",
      "label": "Body",
      "defaultRole": "body"
    },
    {
      "slot": "tag",
      "label": "Tag",
      "defaultRole": "label"
    },
    {
      "slot": "link",
      "label": "Link",
      "defaultRole": "label"
    }
  ],
  "$fragments": [
    "media-side",
    "color-roles"
  ],
  "$fragmentOverrides": {
