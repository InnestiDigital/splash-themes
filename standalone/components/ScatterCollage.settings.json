{
  "component": "ScatterCollage",
  "type": "scatter-collage",
  "label": {
    "en-US": "Scatter Collage"
  },
  "compatibleSectionRoles": ["media-gallery"],
  "settings": [
    {
      "type": "repeater",
      "id": "items",
      "label": {
        "en-US": "Items"
      },
      "group": "content",
      "fields": [
        {
          "type": "text",
          "id": "id",
          "label": {
            "en-US": "Item ID"
          },
          "hidden": true,
          "validation": { "required": true }
        },
        {
          "type": "image",
          "id": "media",
          "label": {
            "en-US": "Image"
          }
        },
        {
          "type": "richtext-inline",
          "id": "caption",
          "label": {
            "en-US": "Caption (optional)"
          },
          "translatable": true,
          "typographyRole": "caption",
          "defaultPresetKey": "caption"
        },
        {
          "type": "number",
          "id": "positionX",
          "label": {
            "en-US": "X Position (center, %)"
          },
          "default": 50,
          "options": {
            "unit": "%",
            "min": -25,
            "max": 125
          }
        },
        {
          "type": "number",
          "id": "positionY",
          "label": {
            "en-US": "Y Position (center, %)"
          },
          "default": 50,
          "options": {
            "unit": "%",
            "min": -25,
            "max": 125
          }
        },
        {
          "type": "number",
          "id": "width",
          "label": {
            "en-US": "Width (%)"
          },
          "default": 30,
          "options": {
            "unit": "%",
            "min": 5,
            "max": 150
          }
        },
        {
          "type": "number",
          "id": "height",
          "label": {
            "en-US": "Height (%)"
          },
          "default": 30,
          "options": {
            "unit": "%",
            "min": 5,
            "max": 150
          }
        },
        {
          "type": "number",
          "id": "scale",
          "label": {
            "en-US": "Scale"
          },
          "default": 1,
          "hidden": true,
          "options": {
            "min": 0.1,
            "max": 3,
            "step": 0.1
          }
        },
        {
          "type": "number",
          "id": "rotation",
          "label": {
            "en-US": "Rotation (deg)"
          },
          "default": 0,
          "options": {
            "unit": "deg",
            "min": -180,
            "max": 180,
            "step": 1
          }
        },
        {
          "type": "number",
          "id": "zIndex",
          "label": {
            "en-US": "Z-Index"
          },
          "default": 1,
          "options": {
            "min": 0,
            "max": 100
          }
        },
        {
          "type": "number",
          "id": "focalX",
          "label": {
            "en-US": "Focal Point X (%)"
          },
          "default": 50,
          "options": {
            "unit": "%",
            "min": 0,
            "max": 100
          }
        },
        {
          "type": "number",
          "id": "focalY",
          "label": {
            "en-US": "Focal Point Y (%)"
          },
          "default": 50,
          "options": {
            "unit": "%",
            "min": 0,
            "max": 100
          }
        }
      ]
    },
    {
      "type": "select",
      "id": "aspectRatio",
      "label": {
        "en-US": "Aspect Ratio"
      },
      "default": "4:5",
      "group": "layout",
      "options": [
        {
          "value": "16:9",
          "label": {
            "en-US": "Wide (16:9)"
          }
        },
        {
          "value": "4:5",
          "label": {
            "en-US": "Portrait (4:5)"
          }
        },
        {
          "value": "1:1",
          "label": {
            "en-US": "Square (1:1)"
          }
        },
        {
          "value": "21:9",
          "label": {
            "en-US": "Ultra-wide (21:9)"
          }
        }
      ]
    },
    {
      "type": "select",
      "id": "mobileMode",
      "label": {
        "en-US": "Mobile Reflow"
      },
      "default": "scale",
      "group": "layout",
      "options": [
        {
          "value": "stack",
          "label": {
            "en-US": "Stack (full-width column)"
          }
        },
        {
          "value": "scale",
          "label": {
            "en-US": "Scale (keep collage)"
          }
        },
        {
          "value": "hybrid",
          "label": {
            "en-US": "Hybrid (scale then stack)"
          }
        }
      ]
    },
    {
      "type": "number",
      "id": "maxCanvasWidth",
      "label": {
        "en-US": "Max Canvas Width (px)"
      },
      "default": 1200,
      "group": "layout",
      "options": {
        "unit": "px",
        "min": 400,
        "max": 1920
      }
    },
    {
      "type": "select",
      "id": "height",
      "label": {
        "en-US": "Section Height"
      },
      "default": "large",
      "group": "layout",
      "options": [
        {
          "value": "auto",
          "label": {
            "en-US": "Auto"
          }
        },
        {
          "value": "viewport",
          "label": {
            "en-US": "Viewport"
          }
        },
        {
          "value": "large",
          "label": {
            "en-US": "Large"
          }
        },
        {
          "value": "medium",
          "label": {
            "en-US": "Medium"
          }
        }
      ]
    },
    {
      "type": "image",
      "id": "backgroundMedia",
      "label": {
        "en-US": "Background Media"
      },
      "group": "style"
    },
    {
      "type": "number",
      "id": "overlayOpacity",
      "label": {
        "en-US": "Overlay Opacity"
      },
      "default": 0,
      "group": "style",
      "options": {
        "min": 0,
        "max": 100
      }
    }
  ],
  "groups": [
    {
      "id": "content",
      "label": {
        "en-US": "Items"
      }
    },
    {
      "id": "layout",
      "label": {
        "en-US": "Layout"
      }
    },
    {
      "id": "style",
      "label": {
        "en-US": "Style"
      }
    }
  ],
  "presets": [
    {
      "name": {
        "en-US": "Empty Scatter"
      },
      "settings": {
        "aspectRatio": "4:5",
        "mobileMode": "scale",
        "maxCanvasWidth": 1200,
        "height": "large",
        "overlayOpacity": 0
      }
    }
  ],
  "targets": {
    "root": {
      "description": "Scatter canvas container"
    },
    "background": {
      "selector": "[data-target='background']",
      "description": "Background layer",
      "multiple": false,
      "animatable": [
        "opacity",
        "transform"
      ],
      "canTrigger": false
    },
    "items": {
      "selector": "[data-target='items']",
      "description": "Scatter items",
      "multiple": true,
      "animatable": [
        "opacity",
        "transform",
        "blur"
      ],
      "canTrigger": true
    },
    "overlay": {
      "selector": "[data-target='overlay']",
      "description": "Color overlay layer",
      "multiple": false,
      "animatable": [
        "opacity"
      ],
      "canTrigger": false
    }
  },
  "motionSupport": {
    "levels": [
      "local",
      "group",
      "choreography"
    ],
    "excluded": []
  }
}
