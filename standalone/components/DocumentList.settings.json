{
  "component": "DocumentList",
  "type": "document-list",
  "label": {
    "en-US": "Document List"
  },
  "category": "content",
  "compatibleSectionRoles": [
    "content",
    "editorial-body",
    "supporting-text"
  ],
  "description": {
    "en-US": "A downloadable documents index — project PDFs, technical drawings, press kits, spec sheets or external resources. Each row is a real download/external link with a file-type icon, type badge and size. Two layouts: editorial rows or a card grid."
  },
  "typographySlots": [],
  "settings": [
    {
      "type": "richtext-single",
      "id": "sectionHeading",
      "label": {
        "en-US": "Section Heading (optional)"
      },
      "group": "content",
      "translatable": true,
      "typographyRole": "sectionTitle",
      "defaultPresetKey": "section-title",
      "validation": {
        "maxLength": 120
      },
      "note": "Optional heading above the list."
    },
    {
      "type": "text",
      "id": "emptyMessage",
      "label": {
        "en-US": "Empty-state message"
      },
      "group": "content",
      "translatable": true,
      "note": "Shown when the list has no documents. Optional; a generic message is used when empty.",
      "validation": {
        "maxLength": 200
      }
    },
    {
      "type": "repeater",
      "id": "documents",
      "label": {
        "en-US": "Documents"
      },
      "group": "content",
      "maxItems": 20,
      "fields": [
        {
          "type": "richtext-single",
          "id": "title",
          "label": {
            "en-US": "Title"
          },
          "translatable": true,
          "typographyRole": "body",
          "defaultPresetKey": "body",
          "validation": {
            "required": true,
            "maxLength": 120
          }
        },
        {
          "type": "richtext-single",
          "id": "description",
          "label": {
            "en-US": "Description"
          },
          "translatable": true,
          "typographyRole": "caption",
          "defaultPresetKey": "caption",
          "note": "Optional secondary line."
        },
        {
          "type": "select",
          "id": "fileType",
          "label": {
            "en-US": "File Type"
          },
          "default": "auto",
          "options": [
            {
              "value": "auto",
              "label": {
                "en-US": "Auto (from URL)"
              }
            },
            {
              "value": "pdf",
              "label": {
                "en-US": "PDF"
              }
            },
            {
              "value": "doc",
              "label": {
                "en-US": "Document"
              }
            },
            {
              "value": "xls",
              "label": {
                "en-US": "Spreadsheet"
              }
            },
            {
              "value": "zip",
              "label": {
                "en-US": "Archive"
              }
            },
            {
              "value": "image",
              "label": {
                "en-US": "Image"
              }
            },
            {
              "value": "dwg",
              "label": {
                "en-US": "CAD / Drawing"
              }
            },
            {
              "value": "link",
              "label": {
                "en-US": "External link"
              }
            }
          ]
        },
        {
          "type": "text",
          "id": "fileSize",
          "label": {
            "en-US": "File Size"
          },
          "note": "Optional, e.g. \"2.4 MB\""
        },
        {
          "type": "text",
          "id": "url",
          "label": {
            "en-US": "URL"
          },
          "note": "Download or external link URL",
          "validation": {
            "required": true
          }
        }
      ]
    },
    {
      "id": "layout",
      "type": "select",
      "label": {
        "en-US": "Layout"
      },
      "default": "list",
      "group": "layout",
      "options": [
        {
          "value": "list",
          "label": {
            "en-US": "List (editorial rows)"
          }
        },
        {
          "value": "cards",
          "label": {
            "en-US": "Cards (grid)"
          }
        }
      ]
    },
    {
      "id": "columns",
      "type": "select",
      "label": {
        "en-US": "Columns"
      },
      "default": "2",
      "group": "layout",
      "showIf": {
        "layout": "cards"
      },
      "options": [
        {
          "value": "2",
          "label": {
            "en-US": "2 columns"
          }
        },
        {
          "value": "3",
          "label": {
            "en-US": "3 columns"
          }
        }
      ]
    },
    {
      "id": "showIcon",
      "type": "toggle",
      "label": {
        "en-US": "Show Icon"
      },
      "default": true,
      "group": "layout",
      "note": "Leading file-type icon."
    },
    {
      "id": "showMeta",
      "type": "toggle",
      "label": {
        "en-US": "Show Meta"
      },
      "default": true,
      "group": "layout",
      "note": "Show the type badge + file size."
    },
    {
      "id": "showDividers",
      "type": "toggle",
      "label": {
        "en-US": "Show Dividers"
      },
      "default": true,
      "group": "layout",
      "note": "Hairline rules between rows (list layout)."
    }
  ],
  "groups": [
    {
      "id": "content",
      "label": {
        "en-US": "Content"
      }
    },
    {
      "id": "layout",
      "label": {
        "en-US": "Layout"
      }
    }
  ],
  "motionSupport": {
    "levels": [
      "local",
      "group"
    ],
    "excluded": []
  },
  "targets": {
    "root": {
      "description": "Entire block container",
      "kind": "root"
    },
    "sectionHeading": {
      "selector": "[data-target='sectionHeading']",
      "description": "Section heading above the list",
      "multiple": false,
      "animatable": [
        "opacity",
        "transform",
        "blur",
        "clip-path"
      ],
      "canTrigger": true,
      "kind": "text"
    },
    "item": {
      "selector": "[data-target='item']",
      "description": "Each document row / card",
      "multiple": true,
      "addressable": true,
      "animatable": [
        "opacity",
        "transform",
        "blur",
        "clip-path"
      ],
      "canTrigger": true,
      "kind": "group"
    },
    "title": {
      "selector": "[data-target='title']",
      "description": "Document title text",
      "multiple": true,
      "animatable": [
        "opacity",
        "transform",
        "blur",
        "clip-path"
      ],
      "kind": "text"
    },
    "meta": {
      "selector": "[data-target='meta']",
      "description": "Document type badge + file size",
      "multiple": true,
      "animatable": [
        "opacity",
        "transform",
        "blur",
        "clip-path"
      ],
      "kind": "text"
    }
  }
}
